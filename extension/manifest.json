{
  "manifest_version": 3,
  "name": "Threads 封鎖工具（修正版）",
  "version": "0.4.2",
  "description": "收集貼文與留言的可見按讚名單，確認已選帳號後逐一封鎖；支援作者選項、暫停、中止與本機紀錄。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.threads.com/*", "https://threads.com/*", "https://www.threads.net/*", "https://threads.net/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Threads 修正版 0.4.2 — 藍色勾盾", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
